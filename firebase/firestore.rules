rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 각 사용자는 자기 데이터(users/<자기 uid>/...)만 읽고 쓸 수 있음
    match /users/{uid}/{col}/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && col in ['cards', 'categories', 'reviews', 'activity'];
    }
    // 의견 보내기: 누구나 새로 쓰기만 가능 (읽기·수정·삭제는 Firebase 콘솔에서만)
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'text', 'email', 'app', 'mode', 'ua', 'uid', 'createdAt'])
        && request.resource.data.kind in ['bug', 'idea', 'question', 'etc']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && (request.resource.data.uid == null || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time;
    }
  }
}
